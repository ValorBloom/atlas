{
  "name": "SFTWindow",
  "type": "object",
  "properties": {
    "start_time": {
      "type": "string",
      "description": "Window start in HHmm"
    },
    "end_time": {
      "type": "string",
      "description": "Window end in HHmm"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "unit": {
      "type": "string"
    },
    "instructor_name": {
      "type": "string"
    },
    "instructor_id": {
      "type": "string"
    },
    "salutation": {
      "type": "string"
    }
  },
  "required": [
    "start_time",
    "end_time",
    "unit"
  ],
  "rls": {
    "create": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "read": {
      "data.unit": "{{user.data.unit}}"
    },
    "update": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "delete": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    }
  }
}