{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Action performed"
    },
    "category": {
      "type": "string",
      "enum": [
        "auth",
        "movement",
        "sft",
        "status",
        "points",
        "parade",
        "import",
        "data_clear",
        "approval",
        "admin"
      ],
      "default": "admin"
    },
    "details": {
      "type": "string"
    },
    "target_entity": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "performed_by": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "category",
    "performed_by"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ],
      "data.unit": "{{user.unit}}"
    },
    "update": false,
    "delete": false
  }
}