{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "target_role": {
      "type": "string",
      "enum": [
        "all",
        "cadet",
        "instructor"
      ],
      "default": "all"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords for CET filtering"
    },
    "sent_by": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "content",
    "unit"
  ],
  "rls": {
    "create": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "read": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "data.target_role": "all"
        },
        {
          "data.target_role": "{{user.data.user_role}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "update": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "delete": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    }
  }
}