{
  "name": "DutyRoster",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Duty date YYYY-MM-DD"
    },
    "duty_type": {
      "type": "string",
      "enum": [
        "CDO",
        "CDS",
        "CDG",
        "Guard Duty",
        "Store Team",
        "Safety Duty"
      ],
      "description": "Type of duty"
    },
    "personnel_name": {
      "type": "string"
    },
    "personnel_rank": {
      "type": "string"
    },
    "personnel_id": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_weekend": {
      "type": "boolean",
      "default": false
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    },
    "point_log_id": {
      "type": "string",
      "description": "Reference to the PointLog record for this duty"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of admin who assigned the duty"
    }
  },
  "required": [
    "date",
    "duty_type",
    "personnel_name",
    "unit"
  ]
}