{
  "name": "DutyRoster",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Duty date YYYY-MM-DD"
    },
    "duty_type": {
      "type": "string",
      "description": "Type of duty (from unit config)"
    },
    "personnel_name": {
      "type": "string"
    },
    "personnel_rank": {
      "type": "string"
    },
    "personnel_id": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_weekend": {
      "type": "boolean",
      "default": false
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of admin who assigned the duty"
    }
  },
  "required": [
    "date",
    "duty_type",
    "personnel_name",
    "unit"
  ]
}