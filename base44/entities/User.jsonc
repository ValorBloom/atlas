{
  "name": "User",
  "type": "object",
  "properties": {
    "user_role": {
      "type": "string",
      "enum": [
        "cadet",
        "cadet_admin",
        "instructor"
      ],
      "default": "cadet",
      "description": "ATLAS role (cadet / cadet_admin / instructor)"
    },
    "unit": {
      "type": "string",
      "description": "Unit assignment"
    },
    "rank": {
      "type": "string",
      "description": "Military rank"
    },
    "phone_number": {
      "type": "string",
      "description": "Contact phone number"
    },
    "platoon": {
      "type": "string",
      "description": "Platoon / Flight / Byte / Division"
    }
  },
  "required": [
    "unit",
    "rank"
  ]
}