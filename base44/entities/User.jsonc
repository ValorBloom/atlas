{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "cadet",
        "cadet_admin",
        "instructor"
      ],
      "default": "cadet",
      "description": "User role"
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has instructor-level privileges"
    },
    "unit": {
      "type": "string",
      "description": "Unit assignment"
    },
    "rank": {
      "type": "string",
      "description": "Military rank"
    },
    "phone_number": {
      "type": "string",
      "description": "Contact phone number"
    },
    "platoon": {
      "type": "string",
      "description": "Platoon / Flight / Byte / Division"
    },
    "section": {
      "type": "string",
      "description": "Section number (for standard units)"
    }
  },
  "required": [
    "role",
    "unit",
    "rank"
  ]
}