{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "User's preferred display name, set during setup and editable by instructors"
    },
    "unit": {
      "type": "string"
    },
    "rank": {
      "type": "string"
    },
    "user_role": {
      "type": "string",
      "description": "cadet, cadet_admin, or instructor"
    },
    "platoon": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "description": "Optional section within platoon"
    }
  },
  "required": [
    "display_name",
    "unit",
    "rank",
    "user_role",
    "platoon"
  ]
}