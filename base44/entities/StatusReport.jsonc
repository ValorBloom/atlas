{
  "name": "StatusReport",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "RSO",
        "MA",
        "RSI",
        "OTHERS",
        "PERM",
        "TEMP"
      ],
      "description": "Status type. PERM/TEMP are manual entries by cadet admin."
    },
    "personnel_name": {
      "type": "string"
    },
    "personnel_rank": {
      "type": "string"
    },
    "personnel_id": {
      "type": "string"
    },
    "symptoms": {
      "type": "string"
    },
    "diagnosis": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "duration_text": {
      "type": "string",
      "description": "Duration display e.g. '2 DAY' or '30 DAYS'"
    },
    "status_category": {
      "type": "string",
      "enum": [
        "MC",
        "Light Duty",
        "Excused RMJ",
        "Excused Heavy Loads",
        "Others"
      ],
      "description": "Primary outcome category after seeing doctor (RSO/RSI only). Mirrors outcomes[0]."
    },
    "outcomes": {
      "type": "array",
      "description": "List of post-consultation outcomes, each with its own category and date range.",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "MC",
              "Light Duty",
              "Excused RMJ",
              "Excused Heavy Loads",
              "Others"
            ]
          },
          "custom_label": {
            "type": "string",
            "description": "Free-text label when category is 'Others'"
          },
          "duration_text": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "pending_approval",
        "approved",
        "rejected"
      ],
      "default": "pending_approval"
    },
    "unit": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string",
      "description": "Rank and name of the instructor who approved the request"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "instructor_notes": {
      "type": "string",
      "description": "Optional notes added by instructor at time of approval or denial"
    }
  },
  "required": [
    "type",
    "personnel_name",
    "unit"
  ],
  "rls": {
    "create": {
      "data.unit": "{{user.unit}}"
    },
    "read": {
      "$or": [
        {
          "data.personnel_id": "{{user.id}}"
        },
        {
          "data.reported_by": "{{user.email}}"
        },
        {
          "data.unit": "{{user.unit}}",
          "$or": [
            {
              "user_condition": {
                "user_role": "instructor"
              }
            },
            {
              "user_condition": {
                "user_role": "cadet_admin"
              }
            },
            {
              "user_condition": {
                "user_role": "medical_officer"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reported_by": "{{user.email}}",
          "data.unit": "{{user.unit}}"
        },
        {
          "data.unit": "{{user.unit}}",
          "$or": [
            {
              "user_condition": {
                "user_role": "instructor"
              }
            },
            {
              "user_condition": {
                "user_role": "cadet_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.unit": "{{user.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    }
  }
}