{
  "name": "StatusReport",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "RSO",
        "MA",
        "RSI",
        "PERM",
        "TEMP"
      ],
      "description": "Status type. PERM/TEMP are manual entries by cadet admin."
    },
    "personnel_name": {
      "type": "string"
    },
    "personnel_rank": {
      "type": "string"
    },
    "personnel_id": {
      "type": "string"
    },
    "symptoms": {
      "type": "string"
    },
    "diagnosis": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "duration_text": {
      "type": "string",
      "description": "Duration display e.g. '2 DAY' or '30 DAYS'"
    },
    "status_category": {
      "type": "string",
      "enum": [
        "MC",
        "Light Duty",
        "Others"
      ],
      "description": "Outcome category after seeing doctor (RSO only)"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "pending_approval",
        "approved",
        "rejected"
      ],
      "default": "active"
    },
    "unit": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "personnel_name",
    "unit"
  ]
}