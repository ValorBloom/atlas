{
  "name": "HomeConfig",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "pinned_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of action keys to show on home screen"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}