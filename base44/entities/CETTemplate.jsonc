{
  "name": "CETTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "unit": {
      "type": "string"
    },
    "timetable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "unit"
  ],
  "rls": {
    "create": {
      "data.unit": "{{user.data.unit}}",
      "user_condition": {
        "user_role": "instructor"
      }
    },
    "read": {
      "data.unit": "{{user.data.unit}}",
      "user_condition": {
        "user_role": "instructor"
      }
    },
    "update": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        }
      ]
    },
    "delete": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        }
      ]
    }
  }
}