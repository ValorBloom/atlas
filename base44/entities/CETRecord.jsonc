{
  "name": "CETRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the CET (YYYY-MM-DD)"
    },
    "unit": {
      "type": "string"
    },
    "wdi": {
      "type": "string",
      "description": "Warrant/Duty Instructor name"
    },
    "quote": {
      "type": "string"
    },
    "quote_author": {
      "type": "string"
    },
    "timetable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "sent_by": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "delivery": {
      "type": "object",
      "description": "Distribution report from the last send/update.",
      "properties": {
        "total_members": {
          "type": "number",
          "description": "Number of unit members targeted"
        },
        "delivered": {
          "type": "number",
          "description": "Number of members the notification reached"
        },
        "failed": {
          "type": "number",
          "description": "Number of members that failed delivery"
        },
        "failures": {
          "type": "array",
          "description": "Emails of members whose notification failed",
          "items": {
            "type": "string"
          }
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "date",
    "unit"
  ],
  "rls": {
    "create": {
      "data.unit": "{{user.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "read": {
      "data.unit": "{{user.unit}}"
    },
    "update": {
      "data.unit": "{{user.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "delete": {
      "data.unit": "{{user.unit}}",
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    }
  }
}