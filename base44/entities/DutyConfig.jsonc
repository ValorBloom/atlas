{
  "name": "DutyConfig",
  "type": "object",
  "properties": {
    "unit": {
      "type": "string",
      "description": "Unit this config belongs to"
    },
    "duty_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "weekday_pts": {
            "type": "number"
          },
          "weekend_pts": {
            "type": "number"
          },
          "color": {
            "type": "string",
            "description": "CSS color key: blue|green|amber|red|violet|orange"
          }
        }
      },
      "description": "List of duty types with point values for this unit"
    }
  },
  "required": [
    "unit"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ],
      "data.unit": "{{user.unit}}"
    },
    "read": {
      "data.unit": "{{user.unit}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ],
      "data.unit": "{{user.unit}}"
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ],
      "data.unit": "{{user.unit}}"
    }
  }
}