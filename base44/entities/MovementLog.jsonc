{
  "name": "MovementLog",
  "type": "object",
  "properties": {
    "personnel_name": {
      "type": "string",
      "description": "Name of person moving"
    },
    "personnel_rank": {
      "type": "string"
    },
    "personnel_id": {
      "type": "string",
      "description": "User ID of person moving"
    },
    "from_location": {
      "type": "string"
    },
    "to_location": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "leave_time": {
      "type": "string",
      "description": "Departure time in HHmm format"
    },
    "reached_time": {
      "type": "string",
      "description": "Arrival time in HHmm format"
    },
    "status": {
      "type": "string",
      "enum": [
        "departed",
        "reached",
        "cancelled"
      ],
      "default": "departed"
    },
    "unit": {
      "type": "string"
    },
    "reported_by": {
      "type": "string",
      "description": "Email of reporting user"
    },
    "movement_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "personnel_name",
    "from_location",
    "to_location",
    "purpose",
    "leave_time",
    "unit"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.unit": "{{user.data.unit}}"
        },
        {
          "$or": [
            {
              "data.personnel_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "instructor"
              }
            },
            {
              "user_condition": {
                "role": "cadet_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.unit": "{{user.data.unit}}"
        },
        {
          "$or": [
            {
              "data.personnel_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "instructor"
              }
            },
            {
              "user_condition": {
                "role": "cadet_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.unit": "{{user.data.unit}}"
        },
        {
          "$or": [
            {
              "data.personnel_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "instructor"
              }
            },
            {
              "user_condition": {
                "role": "cadet_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "user_condition": {
            "role": "instructor"
          }
        },
        {
          "user_condition": {
            "role": "cadet_admin"
          }
        }
      ]
    }
  }
}