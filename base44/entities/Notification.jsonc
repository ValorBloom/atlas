{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "success",
        "info",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "category": {
      "type": "string",
      "enum": [
        "movement",
        "sft",
        "status",
        "points",
        "admin",
        "announcement",
        "approval",
        "system"
      ],
      "default": "system"
    },
    "recipient_email": {
      "type": "string",
      "description": "Target user email"
    },
    "recipient_unit": {
      "type": "string",
      "description": "Target unit for broadcast"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string",
      "description": "Optional navigation link"
    }
  },
  "required": [
    "title",
    "message",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "data.recipient_unit": "{{user.unit}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ],
      "data.recipient_unit": "{{user.unit}}"
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          }
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          }
        }
      ],
      "data.recipient_unit": "{{user.unit}}"
    }
  }
}