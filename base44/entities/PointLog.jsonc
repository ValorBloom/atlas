{
  "name": "PointLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_rank": {
      "type": "string"
    },
    "delta": {
      "type": "number",
      "description": "Points change (positive or negative)"
    },
    "reason": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "action_by": {
      "type": "string",
      "description": "Admin who made the change"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "delta",
    "reason",
    "unit"
  ],
  "rls": {
    "create": {
      "data.unit": "{{user.data.unit}}",
      "$or": [
        {
          "user_condition": {
            "role": "instructor"
          }
        },
        {
          "user_condition": {
            "role": "cadet_admin"
          }
        }
      ]
    },
    "read": {
      "data.unit": "{{user.data.unit}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}