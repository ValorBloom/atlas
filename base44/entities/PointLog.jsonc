{
  "name": "PointLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_rank": {
      "type": "string"
    },
    "delta": {
      "type": "number",
      "description": "Points change (positive or negative)"
    },
    "reason": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "action_by": {
      "type": "string",
      "description": "Admin who made the change"
    }
  },
  "required": [
    "user_id",
    "user_name",
    "delta",
    "reason",
    "unit"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_role": "instructor"
          },
          "data.unit": "{{user.unit}}"
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          },
          "data.unit": "{{user.unit}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "user_role": "instructor"
          },
          "data.unit": "{{user.unit}}"
        },
        {
          "user_condition": {
            "user_role": "cadet_admin"
          },
          "data.unit": "{{user.unit}}"
        }
      ]
    },
    "update": false,
    "delete": false
  }
}